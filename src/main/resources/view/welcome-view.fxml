<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.WelcomeController">
    <top>
        <MenuBar fx:id="mb_main">
            <Menu mnemonicParsing="false" text="Arquivo">
                <MenuItem mnemonicParsing="false" text="Config" />
                <MenuItem mnemonicParsing="false" text="Sair" />
            </Menu>
            <Menu mnemonicParsing="false" text="Ajuda">
                <MenuItem mnemonicParsing="false" text="Regras" />
                <MenuItem mnemonicParsing="false" text="Sobre" />
            </Menu>
        </MenuBar>
    </top>
    <center>
        <VBox alignment="CENTER">
            <ImageView fx:id="img_logo" preserveRatio="true" />
            <TextField fx:id="txf_username" promptText="Nome do Jogador" alignment="CENTER">
                <VBox.margin>
                    <Insets top="80.0" />
                </VBox.margin>
            </TextField>
            <Button fx:id="btn_start" text="Jogar">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Button>
        </VBox>
    </center>
</BorderPane>
