<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.GameController">
    <top>
        <MenuBar fx:id="mb_main">
            <Menu mnemonicParsing="false" text="Arquivo">
                <MenuItem mnemonicParsing="false" text="Sair" onAction="#exitApp"/>
            </Menu>
            <Menu mnemonicParsing="false" text="Ajuda">
                <MenuItem mnemonicParsing="false" text="Regras" onAction="#rulesWindowModal"/>
                <MenuItem mnemonicParsing="false" text="Sobre" onAction="#about" />
            </Menu>
        </MenuBar>
    </top>
    <center>
        <VBox fx:id="vb_main" alignment="TOP_CENTER">
            <StackPane alignment="TOP_CENTER">
                <Label text="Criptex" textAlignment="CENTER" StackPane.alignment="TOP_CENTER">
                    <font>
                        <Font size="23.0" />
                    </font>
                    <StackPane.margin>
                        <Insets bottom="20.0" top="10.0" />
                    </StackPane.margin>
                </Label>
                <StackPane.margin>
                    <Insets right="20.0" />
                </StackPane.margin>
            </StackPane>
            <GridPane fx:id="gp_word_panel" alignment="TOP_CENTER">
                <VBox.margin>
                    <Insets />
                </VBox.margin>
            </GridPane>
            <StackPane>
                <Label fx:id="lbl_stopwatch" alignment="CENTER" contentDisplay="CENTER" text="0:00">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <Label fx:id="lb_invalid_word" alignment="CENTER" contentDisplay="CENTER" text="palavra inválida" textFill="#909090" visible="false">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </StackPane>
            <VBox fx:id="vb_keyboard">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </VBox>
        </VBox>
    </center>
</BorderPane>
