<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="vb_main" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GameController">
   <StackPane alignment="TOP_CENTER">
            <Label text="Criptex" textAlignment="CENTER" StackPane.alignment="TOP_CENTER">
               <font>
                  <Font size="23.0" />
               </font>
         <StackPane.margin>
            <Insets bottom="30.0" top="20.0" />
         </StackPane.margin>
         </Label>
         <Label fx:id="lbl_stopwatch" alignment="TOP_RIGHT" contentDisplay="RIGHT" text="0:00" textFill="RED" StackPane.alignment="TOP_RIGHT">
         <StackPane.margin>
            <Insets right="20.0" top="20.0" />
         </StackPane.margin>
         <font>
            <Font name="System Bold" size="16.0" />
         </font></Label>
      <StackPane.margin>
         <Insets right="20.0" />
      </StackPane.margin>
   </StackPane>

      <GridPane fx:id="gp_word_panel" alignment="TOP_CENTER">
      <VBox.margin>
         <Insets bottom="30.0" />
      </VBox.margin></GridPane>
   <Label fx:id="lb_invalid_word" alignment="CENTER" contentDisplay="CENTER" text="palavra inválida" textFill="#909090" visible="false">
      <font>
         <Font name="System Bold" size="22.0" />
      </font>
      <VBox.margin>
         <Insets bottom="30.0" />
      </VBox.margin>
   </Label>

      <VBox fx:id="vb_keyboard">
      </VBox>
</VBox>
